---
import { formatPrice } from '../lib/format';
import { canCheckout, isPurchasable, type Piece } from '../lib/pieces';
import { CONTACT_EMAIL } from '../lib/site';

interface Props {
	piece: Piece;
}

const { piece } = Astro.props;
const { title, price, stripeUrl } = piece.data;

const forSale = isPurchasable(piece);
const checkoutReady = canCheckout(piece);
const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`Inquiry: ${title}`)}`;
---

{
	forSale &&
		(checkoutReady ? (
			<a class="buy-button" href={stripeUrl} rel="noopener">
				Buy — {formatPrice(price!)}
			</a>
		) : (
			<div class="pending">
				<p class="price">{formatPrice(price!)}</p>
				<p class="note">
					Checkout isn't live for this piece yet —{' '}
					<a href={mailto}>email me to purchase</a>.
				</p>
			</div>
		))
}

<style>
	.buy-button {
		display: inline-block;
		background: var(--terracotta-deep);
		color: var(--paper);
		text-decoration: none;
		font-weight: 600;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius);
	}

	.buy-button:hover {
		opacity: 0.9;
	}

	.pending .price {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		margin: 0;
	}

	.pending .note {
		margin: var(--space-1) 0 0;
		color: var(--sage-deep);
		font-size: var(--text-sm);
	}
</style>
