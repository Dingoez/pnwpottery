---
import SiteMark from './SiteMark.astro';
import { SITE_NAME } from '../lib/site';
---

<header class="site-header">
	<div class="container bar">
		<a href="/" class="mark-link" aria-label={`${SITE_NAME} home`}>
			<SiteMark />
		</a>
		<nav aria-label="Primary">
			<a href="/shop">Shop</a>
			<a href="/gallery">Gallery</a>
			<a href="/blog">Blog</a>
			<a href="/things-i-like">Things I Like</a>
			<a href="/about">About</a>
			<a href="/faq">FAQ</a>
			<a href="/contact">Contact</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--sand);
	}

	/* Stacked by default: the wordmark and seven nav links can't share a row on
	   a phone without overflowing. Side-by-side once there's room. */
	.bar {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding-block: var(--space-3);
	}

	.mark-link {
		text-decoration: none;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
	}

	@media (min-width: 768px) {
		.bar {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-4);
		}

		nav {
			flex-wrap: nowrap;
		}
	}

	nav a {
		text-decoration: none;
		color: var(--ink);
		font-size: var(--text-sm);
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	nav a:hover {
		color: var(--terracotta-deep);
	}
</style>
