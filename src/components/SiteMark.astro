---
// Swappable maker's-mark. Once the real logo SVG arrives, replace this markup
// with `import mark from '../assets/site/mark.svg?raw'` and
// `<Fragment set:html={mark} />` — every caller stays the same.
import { SITE_NAME } from '../lib/site';
---

<span class="site-mark">{SITE_NAME}</span>

<style>
	.site-mark {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		color: var(--ink);
		letter-spacing: 0.01em;
	}
</style>
