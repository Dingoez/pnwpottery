---
import PieceCard from './PieceCard.astro';
import type { Piece } from '../lib/pieces';

interface Props {
	pieces: Piece[];
	showPrice?: boolean;
}

const { pieces, showPrice = false } = Astro.props;
---

<div class="grid">
	{pieces.map((piece) => <PieceCard piece={piece} showPrice={showPrice} />)}
</div>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-4);
	}

	@media (min-width: 768px) {
		.grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
