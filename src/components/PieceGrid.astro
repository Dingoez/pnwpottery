---
import PieceCard from './PieceCard.astro';
import type { Piece } from '../lib/pieces';

interface Props {
	pieces: Piece[];
	showPrice?: boolean;
}

const { pieces, showPrice = false } = Astro.props;
---

<div class="grid">
	{pieces.map((piece) => <PieceCard piece={piece} showPrice={showPrice} />)}
</div>

<style>
	/* A masonry column layout rather than a fixed-aspect-ratio grid — pottery
	   photos run from tall bottle vases to wide shallow bowls, and cropping
	   every thumbnail to the same box was losing real information (a bowl's
	   rim, a vase's full profile). Each card keeps its photo's natural
	   proportions; the columns balance themselves. */
	.grid {
		column-count: 2;
		column-gap: var(--space-4);
	}

	@media (min-width: 768px) {
		.grid {
			column-count: 4;
		}
	}
</style>
