---
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags">
			{tags.map((tag) => (
				<li>{tag}</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li {
		background: var(--blush);
		color: var(--ink);
		font-size: var(--text-sm);
		letter-spacing: 0.03em;
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius);
	}
</style>
