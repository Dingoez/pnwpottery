---
interface Props {
	sold: boolean;
}

const { sold } = Astro.props;
---

{sold && <span class="sold-badge">Sold</span>}

<style>
	.sold-badge {
		display: inline-block;
		background: var(--blush);
		color: var(--ink);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius);
	}
</style>
