---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PieceCarousel from '../../components/PieceCarousel.astro';
import PiecePlacard from '../../components/PiecePlacard.astro';
import SoldBadge from '../../components/SoldBadge.astro';
import BuyButton from '../../components/BuyButton.astro';

export async function getStaticPaths() {
	const pieces = await getCollection('pieces');
	return pieces.map((piece) => ({
		params: { slug: piece.id },
		props: { piece },
	}));
}

const { piece } = Astro.props;
const { title, images, description } = piece.data;
---

<BaseLayout title={title} description={description}>
	<article class="container">
		<PieceCarousel images={images} />

		<h1>{title}</h1>
		<SoldBadge sold={piece.data.sold} />
		<PiecePlacard piece={piece} />
		<BuyButton piece={piece} />

		{description && <p class="description">{description}</p>}
	</article>
</BaseLayout>

<style>
	h1 {
		margin-block: var(--space-4) var(--space-2);
	}

	.description {
		max-width: 65ch;
		margin-top: var(--space-4);
	}
</style>
