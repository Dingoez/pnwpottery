---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PieceGrid from '../components/PieceGrid.astro';
import { getAllPieces } from '../lib/pieces';
import { formatDate } from '../lib/format';
import homeHero from '../assets/pieces/vase-hendrix-01/01.jpg';

const pieces = await getAllPieces();
const featured = pieces.filter((piece) => piece.data.featured).slice(0, 6);

// Empty-safe: the posts collection has no entries yet, so this section simply
// doesn't render until the blog lands.
const posts = await getCollection('posts');
const latestPosts = posts
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 2);
---

<BaseLayout
	title="Home"
	description="Colorful, stenciled, one-of-a-kind ceramics made in Seattle by Tim O'Connell."
>
	<div class="container">
		<section class="intro">
			<a href="/pieces/vase-hendrix-01/" class="intro-photo">
				<Picture
					src={homeHero}
					alt="Cream porcelain bottle vase with a terracotta neck and a stencilled portrait of Jimi Hendrix"
					widths={[400, 700, 1000]}
					sizes="(min-width: 768px) 31.5rem, 85vw"
					formats={['avif', 'webp']}
					fallbackFormat="jpg"
					loading="eager"
					fetchpriority="high"
				/>
				<span class="caption">Hendrix</span>
			</a>
			<div class="intro-text">
				<h1>Colorful, stenciled, one-of-a-kind pots — made in Seattle.</h1>
				<p>
					I'm Tim. I throw and decorate functional sculptures out of the Throw &amp; Build studio in
					Wallingford. <a href="/about">More about me →</a>
				</p>
			</div>
		</section>

		{
			featured.length > 0 && (
				<section class="block">
					<div class="block-head">
						<h2>Featured work</h2>
						<a href="/gallery">See everything →</a>
					</div>
					<PieceGrid pieces={featured} />
				</section>
			)
		}

		{
			latestPosts.length > 0 && (
				<section class="block">
					<div class="block-head">
						<h2>From the blog</h2>
						<a href="/blog">All posts →</a>
					</div>
					<ul class="posts">
						{latestPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<p class="meta">{formatDate(post.data.date)}</p>
								<p>{post.data.description}</p>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</BaseLayout>

<style>
	/* An editorial pairing rather than a full-bleed banner — one real photo,
	   shown whole (no crop) and modestly sized, beside the intro copy. */
	.intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
		padding-block: var(--space-5);
	}

	.intro-photo {
		display: block;
		width: 100%;
		max-width: 28rem;
		text-decoration: none;
	}

	.intro-photo :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.intro-photo .caption {
		display: block;
		margin-top: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--sage-deep);
		text-align: center;
	}

	.intro-photo:hover .caption {
		color: var(--terracotta-deep);
	}

	.intro-text {
		max-width: 40ch;
	}

	.intro-text h1 {
		margin-bottom: var(--space-3);
	}

	.intro-text p {
		margin: 0;
	}

	@media (min-width: 768px) {
		.intro {
			flex-direction: row;
			align-items: center;
			gap: var(--space-6);
		}

		.intro-photo {
			flex-shrink: 0;
			width: 31.5rem;
			max-width: 31.5rem;
		}
	}

	.block {
		margin-block: var(--space-6);
	}

	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-4);
	}

	.block-head a {
		font-size: var(--text-sm);
		white-space: nowrap;
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-4);
	}

	@media (min-width: 768px) {
		.posts {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.posts p {
		margin-block: var(--space-1) 0;
	}

	.meta {
		color: var(--sage-deep);
		font-size: var(--text-sm);
	}
</style>
